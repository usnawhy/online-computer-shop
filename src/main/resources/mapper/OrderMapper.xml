<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shop.computershop.mapper.OrderMapper">

    <resultMap id="orderMap" type="Orders">
        <id property="orderId" column="order_id"/>
        <result property="orderNo" column="order_no"/>
        <result property="userId" column="user_id"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="totalCount" column="total_count"/>
        <result property="status" column="status"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="receiverAddress" column="receiver_address"/>
        <result property="createTime" column="create_time"/>
        <result property="payTime" column="pay_time"/>
        <result property="deliverTime" column="deliver_time"/>
        <result property="finishTime" column="finish_time"/>
    </resultMap>

    <resultMap id="itemMap" type="OrderItem">
        <id property="itemId" column="item_id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="price" column="price"/>
        <result property="count" column="count"/>
        <result property="subtotal" column="subtotal"/>
    </resultMap>

    <select id="findById" resultMap="orderMap">
        SELECT * FROM orders WHERE order_id = #{orderId}
    </select>

    <select id="findByUserId" resultMap="orderMap">
        SELECT * FROM orders WHERE user_id = #{userId} ORDER BY create_time DESC
    </select>

    <select id="findAll" resultMap="orderMap">
        SELECT * FROM orders ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="Orders" useGeneratedKeys="true" keyProperty="orderId">
        INSERT INTO orders(order_no, user_id, total_amount, total_count, status,
                          receiver_name, receiver_phone, receiver_address, create_time)
        VALUES(#{orderNo}, #{userId}, #{totalAmount}, #{totalCount}, #{status},
               #{receiverName}, #{receiverPhone}, #{receiverAddress}, #{createTime})
    </insert>

    <update id="updateStatus">
        UPDATE orders SET status = #{status}
        <choose>
            <when test="status == '已付款'">, pay_time = NOW()</when>
            <when test="status == '已发货'">, deliver_time = NOW()</when>
            <when test="status == '已完成'">, finish_time = NOW()</when>
        </choose>
        WHERE order_id = #{orderId}
    </update>

    <!-- 订单项操作 -->
    <insert id="insertOrderItem" parameterType="OrderItem" useGeneratedKeys="true" keyProperty="itemId">
        INSERT INTO order_item(order_id, product_id, product_name, price, count, subtotal)
        VALUES(#{orderId}, #{productId}, #{productName}, #{price}, #{count}, #{subtotal})
    </insert>

    <select id="findItemsByOrderId" resultMap="itemMap">
        SELECT * FROM order_item WHERE order_id = #{orderId}
    </select>
</mapper>
